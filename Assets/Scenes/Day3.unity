--- !u!114 &487032853
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 487032851}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fb874a701c21551458c9ca0cdfe9295e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DoctorHandbookHover
  handbookImage: {fileID: 487032855}
  rulesPanel: {fileID: 598405695}
  rulesText: {fileID: 382477338}
  handbookContent: "\u0421\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u0438\u043A
    \u0432\u0440\u0430\u0447\u0430\n\n\u0421\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435\n1.
    \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0445
    \u043A\u0430\u0440\u0442\n2. \u0410\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u043A\u043B\u0438\u043D\u0438\u043A\u0438\n\n1. \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430
    \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0445 \u043A\u0430\u0440\u0442\n\u041F\u043E\u043B:
    \u0434\u043E\u043B\u0436\u0435\u043D \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0442\u044C
    \u0441 \u0432\u043D\u0435\u0448\u043D\u043E\u0441\u0442\u044C\u044E \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430.
    \u041C \u2014 \u043C\u0443\u0436\u0447\u0438\u043D\u0430, \u0416 \u2014 \u0436\u0435\u043D\u0449\u0438\u043D\u0430.\n\u0412\u044B\u0434\u0430\u043D\u0430:
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435, \u0432\u044B\u0434\u0430\u0432\u0448\u0435\u0435
    \u043A\u0430\u0440\u0442\u0443, \u0434\u043E\u043B\u0436\u043D\u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0438 \u0432\u0445\u043E\u0434\u0438\u0442\u044C \u0432 \u0441\u043F\u0438\u0441\u043E\u043A
    \u0430\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u043A\u043B\u0438\u043D\u0438\u043A \u0440\u0435\u0433\u0438\u043E\u043D\u0430.\n\u0413\u043E\u0434\u043D\u0430
    \u0434\u043E: \u0434\u0430\u0442\u0430 \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C
    \u043F\u043E\u0437\u0436\u0435 \u0442\u0435\u043A\u0443\u0449\u0435\u0439 \u0434\u0430\u0442\u044B
    \u043D\u0430 \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u0435.\n\u041D\u0430\u043B\u0438\u0447\u0438\u0435
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430: \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0430 \u0434\u043E\u043B\u0436\u043D\u0430
    \u0431\u044B\u0442\u044C \u043C\u0435\u0434\u043A\u0430\u0440\u0442\u0430.\n\n2.
    \u0410\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u043A\u043B\u0438\u043D\u0438\u043A\u0438\n\u0421\u0435\u0432\u0435\u0440\u043E\u0434\u0432\u0438\u043D\u0441\u043A\u0438\u0439
    \u0440\u0435\u0433\u0438\u043E\u043D: \u041C\u0421\u0427 \"\u041F\u043E\u043B\u044F\u0440\u043D\u0430\u044F\";
    \u041A\u0411-41 \"\u041C\u043E\u0440\u043E\u0437\"; \u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430
    \u0438\u043C\u0435\u043D\u0438 \u0425\u043E\u043B\u043E\u0434\u0430.\n\u0417\u0430\u043B\u0435\u0441\u0441\u043A\u0438\u0439
    \u0440\u0435\u0433\u0438\u043E\u043D: \u0414\u0443\u0431\u0440\u0430\u0432\u0430
    \u0426\u0420\u0411; \u041F\u043E\u043B\u0438\u043A\u043B\u0438\u043D\u0438\u043A\u0430
    \u2116 9; \u0421\u0430\u043D\u0430\u0442\u043E\u0440\u0438\u0439 \"\u0418\u0441\u0442\u043E\u043A\".\n\u041F\u0440\u0438\u0433\u043E\u0440\u0441\u043A\u0438\u0439
    \u043E\u043A\u0440\u0443\u0433: \u041C\u0435\u0434\u0446\u0435\u043D\u0442\u0440
    \"\u0412\u044B\u0441\u043E\u0442\u043A\u0430\"; \u041A\u043B\u0438\u043D\u0438\u043A\u0430
    \"\u0425\u0440\u0435\u0431\u0435\u0442\"; \u041C\u0421\u0427 \"\u0413\u0440\u0430\u043D\u0438\u0442\".\n\u041C\u0435\u0436\u0434\u0443\u0440\u0435\u0447\u0435\u043D\u0441\u043A\u0438\u0439
    \u0443\u0437\u0435\u043B: \u0417\u0430\u0432\u043E\u0434\u0441\u043A\u0430\u044F
    \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0430; \u041A\u0411-12 \"\u041F\u0440\u0438\u0447\u0430\u043B\";
    \u041C\u0435\u0434\u0446\u0435\u043D\u0442\u0440 \"\u0420\u0443\u0441\u043B\u043E\".\n\u0421\u0442\u0435\u043F\u043D\u043E\u0432\u0441\u043A\u0430\u044F
    \u0433\u0443\u0431\u0435\u0440\u043D\u0438\u044F: \u041A\u043E\u0432\u044B\u043B\u044C\u0441\u043A\u0430\u044F
    \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0430; \u041A\u0411-5 \"\u041C\u0430\u0440\u0435\u0432\u043E\";
    \u041C\u0435\u0434\u0441\u0430\u043D\u0447\u0430\u0441\u0442\u044C \"\u0417\u0430\u043A\u0430\u0442\".\n\u041E\u0437\u0435\u0440\u0441\u043A\u0438\u0439
    \u043F\u0440\u043E\u0442\u0435\u043A\u0442\u043E\u0440\u0430\u0442: \u041D\u0418\u0418
    \"\u0413\u043B\u0443\u0431\u0438\u043D\u0430\"; \u041A\u043B\u0438\u043D\u0438\u043A\u0430
    \"\u0420\u044F\u0431\u044C\"; \u041C\u0421\u0427 \"\u041A\u0430\u043C\u044B\u0448\".\n\u041E\u0441\u0442\u0440\u043E\u0436\u0441\u043A\u0438\u0439
    \u0441\u0435\u043A\u0442\u043E\u0440: \u0422\u044E\u0440\u0435\u043C\u043D\u0430\u044F
    \u041C\u0421\u0427; \u041A\u0411-88 \"\u0417\u0430\u0441\u043B\u043E\u043D\";
    \u0411\u043E\u043B\u044C\u043D\u0438\u0446\u0430 \"\u0412\u0435\u0447\u0435\"."
  audioSource: {fileID: 487032854}
  hoverSound: {fileID: 0}
  sfxMixerGroup: {fileID: 0}
