  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Day3Controller
  patientImage: {fileID: 2117095771}
  dialogueImage: {fileID: 1658947112}
  patientSprites:
  - {fileID: -8911838625000383935, guid: 23afae2707cef5e49805dd281467c87e, type: 3}
  - {fileID: -9151053978961290498, guid: 9436412f6ac899242ac86754290d0c30, type: 3}
  - {fileID: -2258034487872653507, guid: b5ac094e70867fb4683f898f58b46665, type: 3}
  - {fileID: -6014076404103081887, guid: 9b48d7a7baece37438cadc8ab4634447, type: 3}
  - {fileID: -4884641320120147473, guid: 67d2fb2c4c9192c4c92040b865703ae1, type: 3}
  - {fileID: -5238379129963527962, guid: 7ded5d41a6ce1c2449bae393adf1dc9a, type: 3}
  dialogueSprites: {fileID: -5661048161491472857, guid: e4a3e03ad6a8aaa4aab1d457af9d3f7d, type: 3}
  patientDialogues:
  - "\u042F \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A. \u041F\u043E\u0441\u043B\u0435
    \u043D\u043E\u0447\u043D\u043E\u0439 \u0441\u043C\u0435\u043D\u044B \u0441\u0443\u0445\u043E\u0439
    \u043A\u0430\u0448\u0435\u043B\u044C \u043D\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442,
    \u0433\u0440\u0443\u0434\u044C \u0441\u0430\u0434\u043D\u0438\u0442."
  - "\u042F \u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440. \u041F\u0440\u0438\u0435\u0445\u0430\u043B\u0430
    \u043D\u0430 \u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0443, \u0430 \u043A\u0430\u0448\u0435\u043B\u044C
    \u0443\u0436\u0435 \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C
    \u0441\u0443\u0445\u043E\u0439 \u0438 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0439."
  - "\u042F \u0442\u0430\u043A\u0441\u0438\u0441\u0442, \u0432 \u0433\u043E\u0440\u043E\u0434\u0435
    \u043F\u0440\u043E\u0435\u0437\u0434\u043E\u043C. \u0421\u0443\u0445\u043E\u0439
    \u043A\u0430\u0448\u0435\u043B\u044C \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F,
    \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u0432\u0441\u0435 \u0441
    \u0441\u043E\u0431\u043E\u0439."
  - "\u042F \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043A\u0430, \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0430
    \u0438\u0437 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0430.
    \u041A\u0430\u0448\u043B\u044F\u044E \u0441\u0443\u0445\u043E \u043F\u043E\u0447\u0442\u0438
    \u0431\u0435\u0437 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438."
  - "\u042F \u043A\u0443\u0440\u044C\u0435\u0440 \u0435\u0434\u044B. \u0413\u043E\u043B\u043E\u0432\u0430
    \u0431\u043E\u043B\u0438\u0442, \u043D\u043E\u0441 \u0437\u0430\u043B\u043E\u0436\u0435\u043D,
    \u043D\u043E \u0437\u0430\u043A\u0430\u0437\u043E\u0432 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u043C\u043D\u043E\u0433\u043E."
  - "\u042F \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C,
    \u043F\u0440\u0438\u0435\u0445\u0430\u043B \u043D\u0430 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B.
    \u0421\u0443\u0445\u043E\u0439 \u043A\u0430\u0448\u0435\u043B\u044C \u043C\u0435\u0448\u0430\u0435\u0442
    \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C."
  dialogue: {fileID: 975839589}
