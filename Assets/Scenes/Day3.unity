  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: db25269439fd3b84ea230d9a28122a80, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClipboardHover
  clipboardImage: {fileID: 348396786}
  rulesPanel: {fileID: 598405695}
  rulesText: {fileID: 382477338}
  rulesContent: "\u0414\u0435\u043D\u044C 3 \u2014 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u041D\u0412-3 (\u0441\u0443\u0445\u043E\u0439 \u043A\u0430\u0448\u0435\u043B\u044C)
    \u043D\u0430 16.03.26 \u0421\u0435\u0432\u0435\u0440\u043E\u0434\u0432\u0438\u043D\u0441\u043A\u043E\u0433\u043E
    \u0440\u0435\u0433\u0438\u043E\u043D\u0430:\n\n\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430
    ID: \u0441\u0432\u0435\u0440\u044F\u0439\u0442\u0435 Medical ID \u043F\u043E
    \u0441\u0442\u0430\u0440\u044B\u043C \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C:
    \u0444\u043E\u0442\u043E, \u043F\u043E\u043B, \u0441\u0440\u043E\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    \u0438 \u043A\u043B\u0438\u043D\u0438\u043A\u0430 \u0432\u044B\u0434\u0430\u0447\u0438.\n\nEntry
    Ticket: \u043A\u0430\u0436\u0434\u044B\u0439 \u0438\u043D\u043E\u0433\u043E\u0440\u043E\u0434\u043D\u0438\u0439
    \u043F\u0430\u0446\u0438\u0435\u043D\u0442 \u043E\u0431\u044F\u0437\u0430\u043D
    \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u044C \u0412\u044A\u0435\u0437\u0434\u043D\u043E\u0439
    \u0431\u0438\u043B\u0435\u0442 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 Medical
    ID.\n\n\u0414\u0430\u043D\u043D\u044B\u0435 Medical ID \u0438 Entry Ticket \u0434\u043E\u043B\u0436\u043D\u044B
    \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0442\u044C.\n\n\u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435
    \u0414\u0430\u0442\u0443 \u043F\u0440\u0438\u0431\u044B\u0442\u0438\u044F - \u043E\u043D\u0430
    \u0434\u043E\u043B\u0436\u043D\u0430 \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0442\u044C
    \u0441 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0439 \u0434\u0430\u0442\u043E\u0439."
  audioSource: {fileID: 348396784}
  hoverSound: {fileID: 0}
  sfxMixerGroup: {fileID: 1308846463672463071, guid: 83b9f94bb8100984db9442e8641a5ab9, type: 2}
  useHoverColor: 0
  hoverColor: {r: 1, g: 1, b: 1, a: 1}
  hoverAlpha: 0.8
