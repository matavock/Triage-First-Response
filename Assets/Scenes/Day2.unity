  - "\u0411\u0430\u0440\u0430\u043D\u043E\u0432 \u0412\u043B\u0430\u0434\u0438\u043C\u0438\u0440"
  - "\u041C\u0430\u043B\u044C\u0446\u0435\u0432 \u0414\u0435\u043C\u044C\u044F\u043D"
  - "\u0411\u0430\u0442\u0430\u0435\u0432\u0430 \u041C\u0430\u0434\u0438\u043D\u0430"
  - "\u0410\u043D\u0434\u0440\u0438\u0430\u043D\u043E\u0432 \u0412\u0430\u0434\u0438\u043C"
  patientAges: 360000003f0000001d000000220000001600000027000000
  patientComplaints:
