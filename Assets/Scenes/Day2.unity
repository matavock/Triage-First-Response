  - {fileID: 3686258070518396494, guid: c69e5c35e300cfb47931886712f1b60d, type: 3}
  - {fileID: -8911838625000383935, guid: 23afae2707cef5e49805dd281467c87e, type: 3}
  - {fileID: -4211197294867464897, guid: 429c201e840f79c459f8f5d035863a10, type: 3}
  - {fileID: -2174354462273393540, guid: 391123e63260dc448a1d5aa22147c6d5, type: 3}
  - {fileID: -5238379129963527962, guid: 7ded5d41a6ce1c2449bae393adf1dc9a, type: 3}
  dialogueSprites: {fileID: -5661048161491472857, guid: e4a3e03ad6a8aaa4aab1d457af9d3f7d, type: 3}
  patientDialogues:
  - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435, \u043C\u043E\u043B\u043E\u0434\u043E\u0439
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A! \u0412\u043E\u0442 \u0441\u043F\u0440\u0430\u0432\u043E\u0447\u043A\u0430."
  - "\u0414\u0435\u043D\u044C \u0434\u043E\u0431\u0440\u044B\u0439, \u043A \u0432\u0430\u043C
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E?"
  - "\u041D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439, \u0441\u0430\u043C\u043E\u043A\u0430\u0442\u0435\u0440\u044B
    \u0445\u0440\u0435\u043D\u043E\u0432\u044B..."
  - "\u041F\u043E-\u043C\u043E\u0435\u043C\u0443, \u044F \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B
    \u043A\u043E\u0433\u043E-\u0442\u043E \u043D\u043E\u0447\u044C\u044E..."
  - "\u0417\u0434\u0440\u0430\u0441\u044C\u0442\u0435, \u043C\u0435\u043D\u044F \u0442\u0440\u0435\u043D\u0435\u0440
    \u043A \u0432\u0430\u043C \u043F\u043E\u0441\u043B\u0430\u043B. \u0422\u0430\u043C
    \u0436\u0435 \u043D\u0438\u0447\u0435\u0433\u043E \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u043E\u0433\u043E?"
  - "\u0414\u043E\u0431\u0440\u044B\u0439 \u0434\u0435\u043D\u044C, \u044D-\u044D-\u044D,
    \u0432 \u0441\u043C\u044B\u0441\u043B\u0435 \u043A\u0430\u043A \u044F \u0445\u043E\u0436\u0443?"
  dialogue: {fileID: 548303783}
  correctAnswers: 010001000100
  acceptDepressionValue: 050000000500000005000000e2ffffff05000000e2ffffff
  rejectDepressionValue: e2fffffffbffffffe2ffffff0a000000e2ffffff0a000000
