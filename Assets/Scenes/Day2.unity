  - "\u0421\u0443\u0445\u043E\u0439 \u043A\u0430\u0448\u0435\u043B\u044C\\n\u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430
    38.4\xB0C"
  - "\u0421\u043E\u0442\u0440\u044F\u0441\u0435\u043D\u0438\u0435 \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0433\u043E
