  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClipboardHover
  clipboardImage: {fileID: 1384969764}
  rulesPanel: {fileID: 411118603}
  rulesText: {fileID: 598593393}
  rulesContent: "\u0414\u0435\u043D\u044C 2 \u2014 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B
    \u041D\u0412-2 \u0437\u0430 27.03.2046:\r\n\u0412\u041D\u0418\u041C\u0410\u041D\u0418\u0415!
    \u0412 \u0441\u0432\u044F\u0437\u0438 \u0440\u043E\u0441\u0442\u043E\u043C \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
    \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u044B\u0445 \u043C\u043E\u0448\u0435\u043D\u043D\u0438\u043A\u043E\u0432,
    \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0439\u0442\u0435
    \u0443\u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u0435\u043D\u0438\u044F
    \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u043E\u0432.
    \n\u041D\u0418 \u0432 \u043A\u043E\u0435\u043C \u0441\u043B\u0443\u0447\u0430\u0435
    \u043D\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0439\u0442\u0435 \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u043E\u0432
